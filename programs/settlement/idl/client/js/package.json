{
  "name": "@cowprotocol/solana-settlement-client",
  "version": "0.3.0",
  "description": "TypeScript/JavaScript client for the CoW Protocol Solana settlement program, generated from its IDL.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "(MIT OR Apache-2.0)",
  "author": "CoW Foundation <help@cow.fi>",
  "repository": {
    "type": "git",
    "url": "https://github.com/cowprotocol/solana-programs.git",
    "directory": "programs/settlement/idl/client/js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "solana",
    "cow-protocol",
    "defi",
    "settlement"
  ],
  "peerDependencies": {
    "@solana/kit": "^8"
  },
  "dependencies": {
    "@solana/program-client-core": "^8"
  },
  "devDependencies": {
    "@solana/kit": "^8",
    "@types/node": "^24",
    "litesvm": "^1",
    "prettier": "^3",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3"
  }
}
